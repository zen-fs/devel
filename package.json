{
	"name": "@zenfs/devel",
	"version": "0.1.0",
	"description": "Tooling for developing ZenFS packages",
	"funding": {
		"type": "individual",
		"url": "https://github.com/sponsors/james-pre"
	},
	"keywords": [
		"zenfs",
		"filesystem",
		"testing",
		"eslint"
	],
	"bin": {
		"make-index": "dist/bin/make-index.js",
		"zenfs-test": "dist/bin/zenfs-test.js",
		"zci": "dist/bin/zci.js"
	},
	"files": [
		"dist",
		"tests",
		"eslint.shared.js"
	],
	"type": "module",
	"homepage": "https://github.com/zen-fs/devel",
	"author": "James Prevett <jp@jamespre.dev> (https://jamespre.dev)",
	"license": "LGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zen-fs/devel.git"
	},
	"bugs": {
		"url": "https://github.com/zen-fs/devel/issues"
	},
	"engines": {
		"node": ">= 22"
	},
	"exports": {
		"./eslint": "./eslint.shared.js",
		".": "./dist/index.js",
		"./*": "./dist/*.js"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"spdx:check": "npx lice -a src",
		"spdx:fix": "npx lice -aw src",
		"lint": "eslint src",
		"build": "tsc --build",
		"dev": "tsc --build --watch",
		"test": "node dist/bin/zenfs-test.js dist/tests/setup/memory.js",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"@eslint/js": "^10.0.1",
		"@octokit/action": "^8.0.4",
		"buffer": "^6.0.3",
		"c8": "^12.0.0",
		"globals": "^17.3.0",
		"kerium": "^1.5.0",
		"typescript-eslint": "^8.58.0",
		"utilium": "^3.7.0"
	},
	"peerDependencies": {
		"@zenfs/core": "^2.8.0",
		"eslint": "^10.1.0"
	},
	"peerDependenciesMeta": {
		"eslint": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^26.0.0",
		"@zenfs/core": "^2.8.0",
		"eslint": "^10.1.0",
		"prettier": "^3.2.5",
		"typescript": "^6.0.0"
	},
	"prettier": {
		"singleQuote": true,
		"useTabs": true,
		"tabWidth": 4,
		"printWidth": 150,
		"arrowParens": "avoid",
		"experimentalOperatorPosition": "start"
	}
}
